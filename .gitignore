# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
env/
venv/
ENV/

# Secrets
.env

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db
ehthumbs.db

# Tool caches and logs
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.log

# --- Reinforcement Learning & Training Artifacts ---
# Exclude trained model weights and training state (keep code, not binaries).
# A DQN checkpoint is ~15 MB, and far larger if the replay buffer was saved.
heavy_models/
models/
checkpoints/

# PyTorch / SB3 weights or saved states
*.pt
*.pth
*.ckpt
*.zip

# --- Logging & Monitoring ---
# TensorBoard runs and event logs
tensorboard_logs/
*.tfevents.*

# --- Agent Recordings & Evaluation Outputs ---
# Captured gameplay videos, GIFs, and evaluation logs
videos/
recordings/
eval_results/
*.mp4
*.avi
*.gif
